    "fvh_salt_rong": "H_dom(LN/STRATA/state/fval/v1, value)",
    "h_dom": "BLAKE3(UTF-8(tag) || 0x00 || x)",
    "leaf": "H_dom(LN/STRATA/state/leaf/v1, u32_be(len(key)) || key || fvh)",
    "node": "H_dom(LN/STRATA/state/node/v1, left || right)",
